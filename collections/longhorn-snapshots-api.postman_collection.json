  "item": [
    {
      "id": "4f1c796d-57fc-4ed7-bdf7-1b3e8fb82f86",
      "name": "Snapshots",
      "description": {
        "content": "Snapshot operations for volumes including creating, listing, deleting, reverting to, and purging snapshots. Snapshots capture the state of a volume at a point in time and can be used as the basis for backups.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "203b0ad4-71c5-4114-adc4-d674686270a7",
          "name": "Longhorn Create a snapshot",
          "request": {
            "name": "Longhorn Create a snapshot",
            "description": {
              "content": "Creates a point-in-time snapshot of a Longhorn volume. The volume must be attached when the snapshot is created. Snapshots are stored in the volume's replica data directories and consume incremental space for changed blocks.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "volumes",
                "{{volumeName}}"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "key": "action",
                  "value": "snapshotCreate"
                }
              ],
              "variable": [
                {
                  "description": "Hostname or service name for the Longhorn Manager.",
                  "type": "any",
                  "value": "{{longhornManagerHost}}",
                  "key": "longhornManagerHost"
                },
                {
                  "description": "Port on which Longhorn Manager serves the API.",
                  "type": "any",
                  "value": "{{longhornManagerPort}}",
                  "key": "longhornManagerPort"
                }
              ]
